# Frontend AI provider endpoint. Do not put model API keys in VITE_* variables.
# Leave this empty when using the built-in DeepSeek proxy via npm run dev.
# VITE_AI_COMMAND_ENDPOINT=http://localhost:8787/api/ai/commands

# DeepSeek proxy server settings. The proxy reads process environment variables.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_PROXY_PORT=8787
AI_PROXY_CORS_ORIGIN=*
